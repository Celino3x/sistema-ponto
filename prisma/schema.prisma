generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_CORRECT")
}

model Colaborador {
  id             Int                   @id @default(autoincrement())
  nome           String
  matricula      String                @unique
  endereco       String
  usuario        String                @unique
  senha          String
  role           String                @default("COLABORADOR")
  criadoEm       DateTime              @default(now())
  area           String?
  funcao         String?
  justificativas JustificativaAbono[]
  pontos         Ponto[]
  solicitacoes   SolicitacaoCorrecao[]
}

model Ponto {
  id               Int         @id @default(autoincrement())
  colaboradorId    Int
  entrada          DateTime
  saida            DateTime?
  horasTrabalhadas Float?
  criadoEm         DateTime    @default(now())
  status           String      @default("NORMAL")
  colaborador      Colaborador @relation(fields: [colaboradorId], references: [id])
}

model SolicitacaoCorrecao {
  id            Int         @id @default(autoincrement())
  colaboradorId Int
  pontoId       Int?
  motivo        String
  novaHora      DateTime
  status        String      @default("PENDENTE")
  criadoEm      DateTime    @default(now())
  tipo          String      @default("entrada")
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
}

model JustificativaAbono {
  id            Int         @id @default(autoincrement())
  colaboradorId Int
  dataFalta     DateTime
  motivo        String
  anexoUrl      String?
  status        String      @default("PENDENTE")
  criadoEm      DateTime    @default(now())
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
}
