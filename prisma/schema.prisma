generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Colaborador {
  id              Int                      @id @default(autoincrement())
  nome            String
  matricula       String                   @unique
  endereco        String
  usuario         String                   @unique
  senha           String
  role            String                   @default("COLABORADOR")
  funcao          String?
  area            String?
  pontos          Ponto[]
  solicitacoes    SolicitacaoCorrecao[]
  justificativas  JustificativaAbono[]
  criadoEm        DateTime                 @default(now())
}

model Ponto {
  id              Int         @id @default(autoincrement())
  colaboradorId   Int
  colaborador     Colaborador @relation(fields: [colaboradorId], references: [id])
  entrada         DateTime
  saida           DateTime?
  horasTrabalhadas Float?
  status          String      @default("NORMAL") // Novo campo: "NORMAL" ou "ABONADO"
  criadoEm        DateTime    @default(now())
}

model SolicitacaoCorrecao {
  id              Int         @id @default(autoincrement())
  colaboradorId   Int
  colaborador     Colaborador @relation(fields: [colaboradorId], references: [id])
  pontoId         Int?
  tipo            String      @default("entrada")
  motivo          String
  novaHora        DateTime
  status          String      @default("PENDENTE")
  criadoEm        DateTime    @default(now())
}

model JustificativaAbono {
  id              Int         @id @default(autoincrement())
  colaboradorId   Int
  colaborador     Colaborador @relation(fields: [colaboradorId], references: [id])
  dataFalta       DateTime
  motivo          String
  anexoUrl        String?
  status          String      @default("PENDENTE")
  criadoEm        DateTime    @default(now())
}